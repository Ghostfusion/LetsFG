# LetsFG Python SDK & CLI
#
# The search engine runs server-side, so this image is a thin client: no browser
# and no Chromium. Playwright and its font/system dependencies used to be
# installed here for local connectors that no longer exist.
#
# Build:
#   docker build -f Dockerfile.python -t letsfg .
#
# Search (needs a card-backed PFS token; nothing is charged to connect):
#   docker run --rm -e LETSFG_BEARER_TOKEN=eyJ... letsfg search LON BCN 2026-06-01
#   docker run --rm -e LETSFG_BEARER_TOKEN=eyJ... letsfg locations "New York"
#
# Developer API lane (paid, prepaid balance):
#   docker run --rm -e LETSFG_API_KEY=letsfg_... letsfg search LHR JFK 2026-06-01
#
# Book an offer from a search (holds the fare; there is no unlock step):
#   docker run --rm -e LETSFG_BEARER_TOKEN=eyJ... letsfg book ws_off_xxx --search-id ws_abc \
#     --passenger '{"given_name":"Ada","family_name":"Lovelace","born_on":"1990-04-01","gender":"f"}' \
#     --email you@example.com
#
# Interactive shell:
#   docker run --rm -it --entrypoint bash letsfg

FROM python:3.12-slim

WORKDIR /app

# Copy SDK source and install
COPY sdk/python/pyproject.toml sdk/python/README.md ./
COPY sdk/python/letsfg/ ./letsfg/

RUN pip install --no-cache-dir .

# Runtime environment
ENV PYTHONUNBUFFERED=1 \
    LETSFG_API_KEY=""

ENTRYPOINT ["letsfg"]
CMD ["--help"]
